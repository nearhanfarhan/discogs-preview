# Register an app at https://www.discogs.com/settings/developers
# Callback URL: ${APP_URL}/api/auth/discogs/callback
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Public base URL of this app (no trailing slash)
APP_URL=http://localhost:3000

# 32+ random characters, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Release cache. Local SQLite file by default; use a Turso URL (libsql://...) in production.
DATABASE_URL=file:./data/cache.db
DATABASE_AUTH_TOKEN=
